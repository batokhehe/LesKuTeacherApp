<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="auth"
            type="com.lescepat.teacher.viewmodels.AuthViewModel"/>
    </data>

    <ScrollView
        android:id="@+id/sv_login_form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal">

        <id.co.flipbox.sosoito.LoadingLayout
            android:id="@+id/login_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_user_login_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.lescepat.teacher.views.customviews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_small"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="@string/user_id"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_user_id_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_small"
                    android:layout_marginStart="@dimen/space_small"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/et_email_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_round"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:hint="@string/user_id_hint"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:padding="@dimen/nav_header_vertical_spacing"
                        app:validateEmpty="@{true}"
                        app:validateEmptyAutoDismiss="@{true}" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.lescepat.teacher.views.customviews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_small"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="@string/password"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_small"
                    android:layout_marginStart="@dimen/space_small"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_round"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:hint="@string/password_hint"
                        android:imeOptions="actionUnspecified"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:padding="@dimen/nav_header_vertical_spacing"
                        app:validateEmpty="@{true}"
                        app:validateEmptyAutoDismiss="@{true}" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/shape_rect_button"
                    android:textColor="@color/white"
                    android:text="@string/sign_in" />

                <com.lescepat.teacher.views.customviews.CustomTextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:layout_gravity="right"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/forgot_password"/>

            </LinearLayout>
        </id.co.flipbox.sosoito.LoadingLayout>
    </ScrollView>

</layout>

