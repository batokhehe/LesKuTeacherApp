<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="upcomingOrder"
            type="com.lescepat.teacher.viewmodels.UpcomingOrderViewModel"/>
    </data>
    <androidx.cardview.widget.CardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dip"
        android:elevation="2dp"
        android:background="@drawable/shape_rect_rv_item"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/upcomingOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@{upcomingOrder.id}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dip"
                android:weightSum="1">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/upcomingOrderSubjectName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textStyle="bold"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:text="@{upcomingOrder.subjectName}" />

                    <TextView
                        android:id="@+id/upcomingOrderStudyStartAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="@{upcomingOrder.studyStartAt}" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.4"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/upcomingOrderStudentImage"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:scaleType="fitXY"
                        app:imageStudentUrl="@{upcomingOrder.studentImage}"/>

                    <TextView
                        android:id="@+id/upcomingOrderStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@{upcomingOrder.studentName}" />

                    <TextView
                        android:id="@+id/upcomingOrderStudentAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:text="@{upcomingOrder.studentAddress}" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="@{upcomingOrder.status == 3 ? View.GONE : View.VISIBLE}"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="@{upcomingOrder.getStatusText}"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1"
                android:orientation="horizontal"
                android:visibility="@{upcomingOrder.status == 3 ? View.VISIBLE : View.GONE}">

                <Button
                    android:id="@+id/btn_confirm_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:background="@drawable/shape_rect_button_green"
                    android:text="@string/confirm"
                    android:textColor="@color/white"/>

                <Button
                    android:id="@+id/btn_reschedule_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:layout_margin="@dimen/activity_horizontal_margin"
                    android:background="@drawable/shape_rect_button_red"
                    android:text="@string/reschedule"
                    android:textColor="@color/white"/>

            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</layout>